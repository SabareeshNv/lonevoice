---
/** Books I've read, by the year I finished them: a grid of covers with title and author. */
import { Image } from 'astro:assets';
import PageIntro from '@/components/PageIntro.astro';
import Sidebar from '@/components/Sidebar.astro';
import YearSection from '@/components/YearSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBooksByYear } from '@/lib/books';

const years = await getBooksByYear();
const total = years.reduce((sum, { books }) => sum + books.length, 0);
const lede = `${total} ${total === 1 ? 'book' : 'books'} read, by the year I finished them.`;
---

<BaseLayout title="Books" description="Books read, by year, on Lone Voice.">
  <PageIntro title="Books" hidden lede={total ? lede : 'No books listed yet.'} />
  <div class="years">
    {
      years.map(({ year, books }, i) => (
        <YearSection year={year} past={i > 0}>
          <ul class="books" data-feather>
            {books.map(({ data }, n) => (
              <li class="book">
                {data.cover ? (
                  <Image class="cover" src={data.cover} alt="" width={360} height={540} widths={[180, 270, 360]} sizes="(min-width: 64rem) 11rem, (min-width: 48rem) 9rem, 45vw" />
                ) : (
                  <span class:list={['cover', 'tile', `tile-${n % 3}`]} aria-hidden="true">
                    {[...data.title.replace(/^(the|a|an)\s+/i, '')][0]?.toUpperCase()}
                  </span>
                )}
                <p class="title">{data.title}</p>
                <p class="author">{data.author}</p>
              </li>
            ))}
          </ul>
        </YearSection>
      ))
    }
  </div>
  <Sidebar slot="sidebar" />
</BaseLayout>

<style>
  .years {
    margin-block-start: var(--space-l);
  }

  .books {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m) var(--space-2xs);
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: var(--color-tile);
  }

  /* No picture: a Windows Phone tile with the title's first letter. */
  .tile {
    display: grid;
    place-items: center;
    font-size: 4.5rem;
    font-weight: var(--weight-light);
    line-height: 1;
    color: var(--color-muted);
  }

  .tile-0 {
    background: var(--gradient-zune);
    color: var(--color-on-accent);
  }

  .tile-1 {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .title {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-m);
    font-weight: var(--weight-bold);
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .author {
    margin-block-start: 0.125rem;
    font-size: var(--text-s);
    color: var(--color-muted);
    overflow-wrap: break-word;
  }

  /* Tablet: three a row beside the narrow sidebar. */
  @media (min-width: 48rem) {
    .years {
      margin-block-start: var(--space-xl);
    }

    .books {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-l) var(--space-xs);
      margin-block-start: var(--space-l);
    }

    .tile {
      font-size: 5rem;
    }
  }

  /* Desktop: four a row beside the full sidebar. */
  @media (min-width: 64rem) {
    .books {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .tile {
      font-size: 5.5rem;
    }
  }
</style>
