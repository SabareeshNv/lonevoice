---
/**
 * Typography for long-form text: post bodies, About and the policies.
 * Styles reach rendered Markdown through :global(), scoped to this wrapper.
 */
---

<div class="prose"><slot /></div>

<style>
  .prose {
    font-size: var(--text-l);
    line-height: var(--leading-loose);
    color: var(--color-body);
    /* Long web addresses wrap instead of pushing the page sideways. */
    overflow-wrap: break-word;
  }

  /* Avoid one-word last lines in paragraphs, and break headings evenly. */
  .prose :global(p) {
    text-wrap: pretty;
  }

  .prose > :global(* + *) {
    margin-block-start: var(--space-m);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-block-start: var(--space-xl);
    color: var(--color-fg);
    font-weight: var(--weight-bold);
    line-height: 1.25;
    text-wrap: balance;
  }

  .prose :global(h2) {
    font-size: 1.3125rem;
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
  }

  .prose :global(:is(h2, h3) + *) {
    margin-block-start: var(--space-s);
  }

  /* Plain Markdown links only, not components such as the round buttons. */
  .prose :global(a:not([class])) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: var(--weight-bold);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--space-m);
  }

  .prose :global(li + li) {
    margin-block-start: var(--space-2xs);
  }

  /* Quotations: large and thin, with an accent quote mark. */
  .prose :global(blockquote) {
    margin-block: var(--space-xl);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    line-height: 1.45;
    color: var(--color-fg);
  }

  .prose :global(blockquote::before) {
    content: '“';
    display: block;
    font-size: 4rem;
    line-height: 0.6;
    color: var(--color-accent-text);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    background: var(--color-tile);
  }

  .prose :global(pre) {
    padding: var(--space-s);
    overflow-x: auto;
    background: var(--color-tile) !important;
    font-size: var(--text-s);
    line-height: var(--leading-normal);
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
  }

  /* A picture with a caption (a Markdown image with a title). */
  .prose :global(figure) {
    margin-block: var(--space-l);
  }

  .prose :global(figcaption) {
    margin-block-start: var(--space-xs);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
    color: var(--color-muted);
  }

  /* Tables scroll sideways on a narrow screen instead of squeezing. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-s);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2xs) var(--space-s) var(--space-2xs) 0;
    border-bottom: var(--border-thin);
    text-align: start;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--color-fg);
    font-weight: var(--weight-bold);
  }

  /* Footnotes: small and quiet, under a thin line at the end of the text. */
  .prose :global(section[data-footnotes]) {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-top: var(--border-thin);
    font-size: var(--text-s);
    color: var(--color-muted);
  }

  .prose :global(section[data-footnotes] :is(h2, .sr-only)) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .prose :global(sup) {
    line-height: 0;
  }

  .prose :global(hr) {
    border: 0;
    border-top: var(--border-thin);
  }

  @media (min-width: 48rem) {
    .prose {
      font-size: 1.125rem;
    }

    .prose :global(h2) {
      font-size: 1.625rem;
    }

    .prose :global(blockquote) {
      font-size: 1.625rem;
    }

    .prose :global(pre) {
      padding: var(--space-m);
    }
  }
</style>
