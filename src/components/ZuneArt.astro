---
/**
 * The pink-to-orange angled shapes behind the header, fading into the
 * background on the left so the text in front stays readable.
 */
interface Props {
  /** `large` sits behind the homepage title; `small` behind other headers. */
  size?: 'large' | 'small';
}

const { size = 'small' } = Astro.props;

/*
 * Four shapes, each on its own layer. As the page scrolls, every layer drifts by a
 * different share (`speed`, 0 to 1) of the full drift distance, so the shapes slide
 * across each other: a parallax. Layers are painted in this order (first at the back).
 * Keep every speed at or below 1: the drift distance is the most the shapes can move
 * before a gap opens at the header's top and right edges.
 */
const shapes = [
  { points: '760,0 520,0 300,560 560,560', gradient: 'a', opacity: 0.85, speed: 0.5 },
  { points: '760,60 600,0 380,420 700,560 760,560', gradient: 'b', opacity: 0.55, speed: 0.8 },
  { points: '430,0 330,0 120,560 230,560', gradient: 'a', opacity: 0.28, speed: 0.25 },
  { points: '640,140 760,120 760,380 540,520', gradient: 'a', opacity: 0.45, speed: 1 },
];
---

<div class:list={['art', size]} aria-hidden="true">
  {
    shapes.map((shape, i) => (
      <svg class="layer" viewBox="0 0 760 560" preserveAspectRatio="none" style={`--speed: ${shape.speed}`}>
        <defs>
          <linearGradient id={`zune-${size}-${i}`} x1={shape.gradient === 'a' ? '0' : '1'} y1="0" x2={shape.gradient === 'a' ? '1' : '0'} y2="1">
            <stop offset="0" stop-color={shape.gradient === 'a' ? '#e6007e' : '#ff6a00'} />
            <stop offset="1" stop-color={shape.gradient === 'a' ? '#ff6a00' : '#b0005a'} />
          </linearGradient>
        </defs>
        <polygon points={shape.points} fill={`url(#zune-${size}-${i})`} opacity={shape.opacity} />
      </svg>
    ))
  }
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The fade that keeps the left side (and the text) on a plain background. */
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-bg) 35%, transparent 80%);
  }

  /* Phones: the shapes sit beside the name, clear of the menu below it. */
  .layer {
    /* The most a shape drifts while the page scrolls (see the end of this file); each
       layer moves a share of it (--speed). Kept inside the margin the shapes already
       overhang the header by, so no gap opens up. */
    --drift-x: -1.5rem;
    --drift-y: 0.5rem;
    position: absolute;
    top: -0.75rem;
    right: -2rem;
    width: 11rem;
    height: 6.25rem;
  }

  .large .layer {
    width: 24rem;
    height: 15rem;
    right: -5rem;
  }

  /* Tablet and desktop: the shapes sweep out from behind the end of the name. */
  @media (min-width: 48rem) {
    .small .layer {
      width: 60rem;
      height: 26rem;
      top: -3.5rem;
      right: -8rem;
    }

    .large .layer {
      width: 76rem;
      height: 38rem;
      top: -4rem;
      right: -8rem;
    }

    .small::after {
      background: linear-gradient(90deg, var(--color-bg) 8%, transparent 44%);
    }

    .large::after {
      background: linear-gradient(90deg, var(--color-bg) 6%, transparent 40%);
    }

    .layer {
      --drift-x: -5rem;
      --drift-y: 2rem;
    }
  }

  /*
   * The shapes drift slowly as the page scrolls: left and a little down, so they lag
   * behind the header like the background of a Windows Phone panorama, each at its own
   * depth (--speed) so they slide across each other. Driven by the
   * scroll position in CSS, so there is no script. Browsers without scroll-driven
   * animations (and readers who ask for less motion) simply see the shapes still.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .layer {
        animation: drift linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 25rem; /* about the height of the header: it has scrolled away by then */
      }
    }
  }

  @keyframes drift {
    to {
      transform: translate(calc(var(--drift-x) * var(--speed)), calc(var(--drift-y) * var(--speed)));
    }
  }
</style>
