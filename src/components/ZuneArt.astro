---
/**
 * The pink-to-orange angled shapes behind the header, fading into the
 * background on the left so the text in front stays readable.
 */
interface Props {
  /** `large` sits behind the homepage title; `small` behind other headers. */
  size?: 'large' | 'small';
}

const { size = 'small' } = Astro.props;
---

<div class:list={['art', size]} aria-hidden="true">
  <svg viewBox="0 0 760 560" preserveAspectRatio="none">
    <defs>
      <linearGradient id={`zune-a-${size}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e6007e"></stop>
        <stop offset="1" stop-color="#ff6a00"></stop>
      </linearGradient>
      <linearGradient id={`zune-b-${size}`} x1="1" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ff6a00"></stop>
        <stop offset="1" stop-color="#b0005a"></stop>
      </linearGradient>
    </defs>
    <polygon points="760,0 520,0 300,560 560,560" fill={`url(#zune-a-${size})`} opacity="0.85"></polygon>
    <polygon points="760,60 600,0 380,420 700,560 760,560" fill={`url(#zune-b-${size})`} opacity="0.55"></polygon>
    <polygon points="430,0 330,0 120,560 230,560" fill={`url(#zune-a-${size})`} opacity="0.28"></polygon>
    <polygon points="640,140 760,120 760,380 540,520" fill={`url(#zune-a-${size})`} opacity="0.45"></polygon>
  </svg>
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The fade that keeps the left side (and the text) on a plain background. */
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-bg) 35%, transparent 80%);
  }

  /* Phones: the shapes sit beside the name, clear of the menu below it. */
  svg {
    /* How far the shapes drift while the page scrolls (see the end of this file).
       Kept inside the margin the shapes already overhang by, so no gap opens up. */
    --drift-x: -1.5rem;
    --drift-y: 0.5rem;
    position: absolute;
    top: -0.75rem;
    right: -2rem;
    width: 11rem;
    height: 6.25rem;
  }

  .large svg {
    width: 24rem;
    height: 15rem;
    right: -5rem;
  }

  /* Tablet and desktop: the shapes sweep out from behind the end of the name. */
  @media (min-width: 48rem) {
    .small svg {
      width: 60rem;
      height: 26rem;
      top: -3.5rem;
      right: -8rem;
    }

    .large svg {
      width: 76rem;
      height: 38rem;
      top: -4rem;
      right: -8rem;
    }

    .small::after {
      background: linear-gradient(90deg, var(--color-bg) 8%, transparent 44%);
    }

    .large::after {
      background: linear-gradient(90deg, var(--color-bg) 6%, transparent 40%);
    }

    svg {
      --drift-x: -5rem;
      --drift-y: 2rem;
    }
  }

  /*
   * The shapes drift slowly as the page scrolls: left and a little down, so they lag
   * behind the header like the background of a Windows Phone panorama. Driven by the
   * scroll position in CSS, so there is no script. Browsers without scroll-driven
   * animations (and readers who ask for less motion) simply see the shapes still.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      svg {
        animation: drift linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 25rem; /* about the height of the header: it has scrolled away by then */
      }
    }
  }

  @keyframes drift {
    to {
      transform: translate(var(--drift-x), var(--drift-y));
    }
  }
</style>
