---
/**
 * The posts page (/posts/): every post, by year and month, one row each with
 * its date and title. Split into pages (/posts/page/2/…) once there are more posts
 * than SITE.archivePageSize. A single post lives at /posts/<name>/ (see [slug].astro).
 * Page 1 is src/pages/posts/index.astro, the rest src/pages/posts/page/[page].astro.
 */
import EmptyState from '@/components/EmptyState.astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import YearSection from '@/components/YearSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dateParts } from '@/lib/format';
import type { Pager } from '@/lib/pagination';
import { displayTitle, groupByYearAndMonth, type Post, postUrl } from '@/lib/posts';

interface Props {
  page: Pager<Post>;
  latestYear?: string | number;
}

const { page, latestYear } = Astro.props;
const years = groupByYearAndMonth(page.data);
const first = page.currentPage === 1;
const title = first ? 'Posts' : `Posts, page ${page.currentPage} of ${page.lastPage}`;
const description = first
  ? 'Every post on Lone Voice, by month.'
  : `Every post on Lone Voice, by month, page ${page.currentPage}.`;
---

<BaseLayout title={title} description={description} sidebarOffset="calc(-1 * var(--space-s))">
  <h1 class="visually-hidden">Posts</h1>
  {!years.length && <EmptyState>no posts yet.</EmptyState>}
  {
    years.map(({ year, months }) => (
      <YearSection year={year} past={year !== latestYear}>
        {months.map(({ month, posts }) => (
          <section class="month" aria-label={`${month} ${year}`}>
            <h3 class="month-title">{month}</h3>
            <ul class="rows">
              {posts.map((post) => {
                const { day, month: mon } = dateParts(post.data.date);
                return (
                  <li>
                    <a href={postUrl(post)}>
                      <time datetime={post.data.date.toISOString()}>
                        {day} {mon}
                      </time>
                      <span class:list={['name', { untitled: !post.data.title }]}>{displayTitle(post)}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </YearSection>
    ))
  }
  <Pagination page={page} label="More archive pages" />
  <Sidebar slot="sidebar" />
</BaseLayout>

<style>
  .month {
    margin-block-start: var(--space-l);
  }

  .month-title {
    margin-block-end: var(--space-xs);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
  }

  .rows {
    padding: 0;
    list-style: none;
    border-top: var(--border-thin);
  }

  .rows li {
    border-bottom: var(--border-thin);
  }

  .rows a {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
    padding-block: 0.875rem;
  }

  .rows a:hover {
    text-decoration: none;
  }

  .rows a:hover .name {
    text-decoration: underline;
  }

  time {
    flex-shrink: 0;
    width: 3.25rem;
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    color: var(--color-muted);
  }

  .name {
    font-size: var(--text-m);
    font-weight: var(--weight-bold);
    line-height: 1.45;
  }

  .untitled {
    font-weight: var(--weight-regular);
    color: var(--color-body);
  }

  @media (min-width: 48rem) {
    .month {
      margin-block-start: var(--space-xl);
    }

    .month-title {
      margin-block-end: var(--space-s);
      font-size: var(--text-3xl);
    }

    .rows a {
      gap: var(--space-m);
      padding-block: var(--space-s);
    }

    time {
      width: 4rem;
      font-size: var(--text-xs);
    }

    .name {
      font-size: 1.125rem;
    }
  }
</style>
