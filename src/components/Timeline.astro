---
import type { Post } from '@/lib/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  /** The first post's picture is the first thing a visitor sees: load it at once (only if it has one). */
  eagerFirst?: boolean;
}

const { posts, eagerFirst = false } = Astro.props;
---

<div class="timeline">
  {posts.map((post, index) => <PostCard post={post} eager={eagerFirst && index === 0} />)}
</div>

<style>
  .timeline > :global(:first-child) {
    padding-block-start: 0;
  }

  @media (min-width: 48rem) {
    .timeline > :global(:first-child) > :global(*) {
      padding-block-start: 0;
    }
  }
</style>
