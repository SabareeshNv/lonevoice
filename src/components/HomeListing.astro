---
/**
 * The homepage's list of posts, newest first, ten to a page: page 1 is / and the
 * rest are /page/2/, /page/3/… (see src/pages/index.astro and src/pages/page/[page].astro).
 */
import EmptyState from '@/components/EmptyState.astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import Timeline from '@/components/Timeline.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Pager } from '@/lib/pagination';
import type { Post } from '@/lib/posts';
import { websiteSchema } from '@/lib/seo';
import { SITE } from '@/site.config';

interface Props {
  page: Pager<Post>;
}

const { page } = Astro.props;
const first = page.currentPage === 1;
const title = first ? undefined : `Page ${page.currentPage} of ${page.lastPage}`;
const description = first ? SITE.description : `Older posts on ${SITE.title}, page ${page.currentPage}.`;
---

<BaseLayout title={title} description={description} header="home" schema={first ? [websiteSchema()] : []}>
  <h2 class="visually-hidden">Latest posts</h2>
  {page.data.length ? <Timeline posts={page.data} eagerFirst /> : <EmptyState>nothing written here yet.</EmptyState>}
  <Pagination page={page} />
  <Sidebar slot="sidebar" showIntro={page.currentPage === 1} />
</BaseLayout>
