---
/**
 * One post on a timeline. Its shape depends on what the post has:
 * - title (+ cover)  → title, summary and tags; with a cover, the title sits inside the picture
 * - cover, no title  → a photo post: the picture full width, then the text
 * - neither          → a note: the full text
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { fullDate } from '@/lib/format';
import { isPhoto, postUrl, summary, type Post } from '@/lib/posts';
import Icon from './Icon.astro';
import LinkCard from './LinkCard.astro';
import PostDate from './PostDate.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, cover, coverAlt, tags, date, link, linkTitle } = post.data;
const url = postUrl(post);
const photo = isPhoto(post);
const { Content } = !title ? await render(post) : { Content: null };
---

<article class="post feather" style={`--i: ${index}`} data-post-id={post.id}>
  <PostDate date={date} continuum />
  <div class="body">
    {
      title ? (
        <div class:list={['titled', { 'has-thumb': cover }]}>
          <h2 class="title" data-continuum="title">
            <a class="tap" href={url}>{title}</a>
          </h2>
          <p class="summary">{summary(post)}</p>
          {cover && (
            <a class="thumb" href={url} tabindex="-1" aria-hidden="true" data-continuum="cover">
              <Image src={cover} alt="" width={480} />
            </a>
          )}
        </div>
      ) : photo && cover ? (
        <>
          <a class="photo" href={url} data-continuum="cover">
            <Image src={cover} alt={coverAlt ?? ''} width={1200} />
          </a>
          <div class="caption">{Content && <Content />}</div>
        </>
      ) : (
        <div class="note">{Content && <Content />}</div>
      )
    }
    {link && <LinkCard url={link} title={linkTitle} />}
    {/* Every post has a way in: titled posts have more to read, notes and photos are shown in full. */}
    <div class="foot">
      <TagList tags={tags} />
      <a class="more tap" href={url}>
        {title ? 'continue reading' : 'view post'}
        <span class="visually-hidden">: {title ?? fullDate(date)}</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .post {
    padding-block: var(--space-post);
    border-bottom: var(--border-thin);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-start: var(--space-2xs);
  }

  .titled {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /*
   * With a cover, the title sits inside the bottom of the picture (the Windows
   * Phone tile look), and the summary follows below. The title and the cover share
   * one grid cell. The title has no left padding, so its left edge lines up with
   * the picture's edge and with the summary and tags below. A long title has the
   * whole picture width to wrap across. The dark fade is behind the title only,
   * so the picture keeps its colour and a short title barely darkens it.
   */
  .titled.has-thumb {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'media'
      'summary';
    row-gap: var(--space-s);
  }

  .has-thumb .title {
    grid-area: media;
    align-self: end;
    z-index: 1;
    padding: var(--space-xl) var(--space-m) var(--space-s) 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.62) 55%, transparent 100%);
  }

  .has-thumb .title a {
    color: var(--color-fg);
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.55);
  }

  /* Over a picture the title doesn't underline on hover. */
  .has-thumb .title a:hover {
    text-decoration: none;
  }

  .has-thumb .summary {
    grid-area: summary;
  }

  .thumb {
    grid-area: media;
    aspect-ratio: var(--ratio-card);
  }

  /* A block link, so the tap area covers every line of a long title. */
  .title a {
    display: block;
  }

  .title {
    view-transition-class: text;
    font-size: var(--text-post-title);
    font-weight: var(--weight-bold);
    letter-spacing: -0.015em;
  }

  .summary,
  .caption {
    font-size: var(--text-m);
    color: var(--color-body);
  }

  /* Tags on the left, “continue reading” (or “view post”) on the right edge, in one row. */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
  }

  /* White, not pink: pink marks topics, white marks the way into the post. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-inline-start: auto;
    font-size: var(--text-s);
    font-weight: var(--weight-bold);
    color: var(--color-fg);
    white-space: nowrap;
  }

  .more :global(svg) {
    transition: transform 0.15s;
  }

  .more:hover :global(svg) {
    transform: translateX(0.2rem);
  }

  .thumb,
  .photo {
    display: block;
    view-transition-class: cover;
    overflow: hidden;
    background: var(--color-tile);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .note {
    font-size: var(--text-l);
  }

  .note :global(p + p),
  .caption :global(p + p) {
    margin-block-start: var(--space-xs);
  }

  .note :global(a),
  .caption :global(a) {
    color: var(--color-accent-text);
    text-decoration: underline;
  }

  /* Tablets and up: date block on the left, a thin divider, then the post. */
  @media (min-width: 48rem) {
    .post {
      display: grid;
      grid-template-columns: var(--size-date-column) minmax(0, 1fr);
      padding-block: 0;
    }

    .post > :global(.date) {
      padding-block: var(--space-post);
    }

    .body {
      gap: var(--space-s);
      margin: 0;
      padding: var(--space-post) 0 var(--space-xl) var(--space-post-gutter);
      border-left: var(--border-thin);
    }

    .titled {
      gap: var(--space-s);
    }

    .summary,
    .caption {
      font-size: var(--text-l);
    }


    .note {
      font-size: var(--text-xl);
      padding-block-start: var(--space-xs);
    }
  }
</style>
