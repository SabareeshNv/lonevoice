---
/**
 * The round outlined Windows Phone app-bar button: an icon in a circle,
 * optionally followed by a text label.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  /** Where the link goes. Left out for a share button (see `share`). */
  href?: string;
  /** Makes a real `<button>` that the page script turns into a share window. */
  share?: string;
  icon: IconName;
  /** Visible text beside the circle. Without it, `label` names the button. */
  text?: string;
  label?: string;
  current?: boolean;
  /** Another site: opens in a new tab, outside the page-change animations. */
  external?: boolean;
}

const { href = '', share, icon, text, label, current = false, external = false } = Astro.props;

// Brand marks are drawn smaller inside their box, so give them a bigger one to match the line icons.
const brands: IconName[] = ['facebook', 'x', 'telegram', 'whatsapp', 'rss'];
const iconSize = brands.includes(icon) ? 24 : 18;

// A file (e.g. /rss.xml) isn't a page: let the browser load it normally,
// without the page-change animations.
const isFile = !external && /\.[a-z0-9]+$/i.test(href.split(/[?#]/)[0] ?? '');
---

{
  share ? (
    // Not a link on purpose: ad blockers (Brave, uBlock…) hide any <a> whose
    // address looks like a share link. The address is built when it's tapped.
    <button type="button" class="round" data-share={share} aria-label={label}>
      <span class="circle">
        <Icon name={icon} size={iconSize} />
      </span>
    </button>
  ) : (
    <a
      href={href}
      class:list={['round', { current }]}
      aria-label={text ? undefined : label}
      aria-current={current ? 'page' : undefined}
      data-astro-reload={isFile ? true : undefined}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <span class="circle">
        <Icon name={icon} size={iconSize} />
      </span>
      {text && <span class="text">{text}</span>}
    </a>
  )
}

<style>
  .round {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-l);
    font-weight: var(--weight-regular);
  }

  .round:hover {
    text-decoration: none;
  }

  button.round {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .circle {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--size-touch);
    height: var(--size-touch);
    border: 2px solid var(--color-fg);
    border-radius: 50%;
    background: var(--color-bg);
    transition: background 0.15s, color 0.15s;
  }

  .round:hover .circle,
  .current .circle {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
