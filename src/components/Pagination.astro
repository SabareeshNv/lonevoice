---
import type { Pager } from '@/lib/pagination';
import type { Post } from '@/lib/posts';
import RoundButton from './RoundButton.astro';

interface Props {
  page: Pager<Post>;
  /** Accessible name of the navigation. */
  label?: string;
}

const { page, label = 'More posts' } = Astro.props;
const { prev, next } = page.url;
---

{
  (prev || next) && (
    <nav class="pagination" aria-label={label}>
      {prev && <RoundButton href={prev} icon="arrow-left" text="newer posts" />}
      {next && <RoundButton href={next} icon="arrow-down" text="older posts" />}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s) var(--space-xl);
    padding-block-start: var(--space-xl);
  }
</style>
