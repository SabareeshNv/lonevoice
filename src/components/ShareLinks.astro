---
/**
 * Round buttons that share the current page on Facebook, X, Telegram and
 * WhatsApp: no trackers, no third-party scripts. A tap opens the service's
 * share page in a new tab, and the service builds the preview from the page's
 * Open Graph tags. A small "share" label sits above the row. Used in the
 * sidebar and on About.
 *
 * These are buttons, not links. Ad blockers (Brave Shields, uBlock Origin…)
 * hide any link whose address starts with a known share address, so the
 * address is only built in the script below, when a button is tapped.
 */
import { SITE } from '@/site.config';
import RoundButton from './RoundButton.astro';
import type { IconName } from './Icon.astro';

const services: { id: string; name: string; icon: IconName }[] = [
  { id: 'facebook', name: 'Facebook', icon: 'facebook' },
  { id: 'x', name: 'X', icon: 'x' },
  { id: 'telegram', name: 'Telegram', icon: 'telegram' },
  { id: 'whatsapp', name: 'WhatsApp', icon: 'whatsapp' },
];
---

<div class="share" data-site={SITE.url}>
  <p class="label" id="share-label">share</p>
  <ul aria-labelledby="share-label">
    {
      services.map((s) => (
        <li>
          <RoundButton share={s.id} icon={s.icon} label={`Share on ${s.name}`} />
        </li>
      ))
    }
  </ul>
</div>

<script>
  // One listener for every share button, on every page. The address is read
  // when a button is tapped, so it is always the page being shown.
  const targets: Record<string, (url: string) => string> = {
    facebook: (url) => `https://www.facebook.com/sharer/sharer.php?u=${url}`,
    x: (url) => `https://x.com/intent/tweet?url=${url}`,
    telegram: (url) => `https://t.me/share/url?url=${url}`,
    whatsapp: (url) => `https://wa.me/?text=${url}`,
  };

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('button[data-share]');
    if (!button) return;
    const build = targets[button.dataset.share ?? ''];
    const site = button.closest<HTMLElement>('[data-site]')?.dataset.site;
    if (!build || !site) return;
    // The public address, even on a preview site, so the shared link is the real one.
    const page = encodeURIComponent(new URL(location.pathname, site).href);
    window.open(build(page), '_blank', 'noopener,noreferrer');
  });
</script>

<style>
  .label {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-l);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    color: var(--color-fg);
  }

  .share ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Undo prose list spacing on the About page. */
  .share li {
    margin: 0;
  }
</style>
