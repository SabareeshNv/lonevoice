---
/**
 * Everything in <head>: title, description, canonical link, link-preview
 * tags (Open Graph, Twitter), structured data and the page-transition router.
 */
// Open Sans, self-hosted. Only the alphabets the site uses are loaded: Latin
// (English and most European names), Latin extended, and the math and symbols
// sets (they hold the ← → arrows). The full package also has Cyrillic, Greek,
// Hebrew and Vietnamese, which would add about 25 KB to every page's CSS. To
// add one, import e.g. '@fontsource/open-sans/vietnamese-400.css' for each weight.
import '@fontsource/open-sans/latin-300.css';
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-600.css';
import '@fontsource/open-sans/latin-ext-300.css';
import '@fontsource/open-sans/latin-ext-400.css';
import '@fontsource/open-sans/latin-ext-600.css';
import '@fontsource/open-sans/math-300.css';
import '@fontsource/open-sans/math-400.css';
import '@fontsource/open-sans/math-600.css';
import '@fontsource/open-sans/symbols-300.css';
import '@fontsource/open-sans/symbols-400.css';
import '@fontsource/open-sans/symbols-600.css';
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@/site.config';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Link-preview image: a cover (cropped to 1200×630) or a path in public/. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Keep the page out of search results (search results page, 404). */
  noindex?: boolean;
  /** schema.org objects, rendered as JSON-LD. */
  schema?: Record<string, unknown>[];
}

type Props = SeoProps;

const {
  title,
  description = SITE.description,
  image = SITE.socialImage,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  schema = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Covers are cropped to the 1200×630 size that link previews expect.
const SOCIAL = { width: 1200, height: 630 };
const imagePath =
  typeof image === 'string'
    ? image
    : (await getImage({ src: image, ...SOCIAL, fit: 'cover', format: 'jpg', quality: 82 })).src;
const imageUrl = new URL(imagePath, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#000000" />

{/* Link previews */}
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale.replace('-', '_')} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(SOCIAL.width)} />
<meta property="og:image:height" content={String(SOCIAL.height)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{/* Structured data */}
{schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

{/* Page transitions: see src/lib/motion.ts and src/styles/motion.css. */}
<ClientRouter />
