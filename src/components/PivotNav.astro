---
/**
 * The Windows Phone “pivot” menu: large light words, the current page in
 * full colour and the others greyed out.
 */
import { NAV } from '@/site.config';

/**
 * Which menu item the current URL belongs to: the first segment of the URL
 * (so /posts/<name>/ belongs to "posts"), except that home's later pages
 * (/2/, /3/…) belong to "home".
 */
const first = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const section = /^\d+$/.test(first) ? '' : first;
const isCurrent = (match: string) => section === match;
---

<nav aria-label="Sections">
  <ul>
    {
      NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.match) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Phones: one row that scrolls sideways, like a Windows Phone pivot. */
  ul {
    display: flex;
    gap: 0 var(--space-m);
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
    padding: 0;
    list-style: none;
    font-size: var(--text-pivot);
    font-weight: var(--weight-light);
    letter-spacing: -0.02em;
  }

  a {
    display: block;
    padding-block: var(--space-2xs) var(--space-xs);
    color: var(--color-muted);
  }

  a[aria-current='page'] {
    color: var(--color-fg);
  }

  a:hover {
    color: var(--color-fg);
    text-decoration: none;
  }

  ul::-webkit-scrollbar {
    display: none;
  }

  /*
   * Phones: a soft fade at the right edge shows the menu scrolls sideways.
   * The spacer after the last item lets it scroll fully clear of the fade.
   */
  ul {
    mask-image: linear-gradient(to right, #000 calc(100% - var(--space-xl)), transparent);
  }

  ul::after {
    content: '';
    flex: 0 0 var(--space-l);
  }

  @media (min-width: 48rem) {
    ul {
      flex-wrap: wrap;
      gap: 0 var(--space-l);
      overflow-x: visible;
      mask-image: none;
    }

    ul::after {
      content: none;
    }

    a {
      padding-block-end: var(--space-s);
    }
  }
</style>
