---
/**
 * The shell of every page: <head>, skip link, header, main and footer.
 *
 * Content goes in the default slot. Pass a `sidebar` slot to get the
 * two-column layout on large screens; without it the page is one column.
 */
import BaseHead, { type SeoProps } from '@/components/BaseHead.astro';
import CoverFlight from '@/components/CoverFlight.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { pageAnimation } from '@/lib/transitions';
import { SITE } from '@/site.config';

interface Props extends SeoProps {
  header?: 'home' | 'page';
  /** Moves the sidebar up or down so its first line lines up with the page's (a CSS length). */
  sidebarOffset?: string;
}

const { header = 'page', sidebarOffset, ...seo } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader variant={header} search={hasSidebar ? 'mobile' : 'always'} />
    <div class:list={['container', 'layout', { 'with-sidebar': hasSidebar }]}>
      <main id="content" class="main" transition:name="main" transition:animate={pageAnimation}>
        <slot />
      </main>
      {
        hasSidebar && (
          <aside
            class="sidebar"
            aria-label={`More from ${SITE.title}`}
            style={sidebarOffset ? `--sidebar-offset: ${sidebarOffset}` : undefined}
            transition:name="sidebar"
            transition:animate="none"
          >
            <slot name="sidebar" />
          </aside>
        )
      }
    </div>
    <SiteFooter />
    <CoverFlight />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    z-index: 10;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-accent);
    color: var(--color-on-accent);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .layout {
    padding-block-start: var(--space-header);
  }

  .main {
    min-width: 0;
    max-width: var(--width-main);
  }

  /* Phones: the sidebar follows the main content. */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-block-start: var(--space-2xl);
  }

  /* Tablet and desktop: posts and sidebar side by side (sizes from tokens). */
  @media (min-width: 48rem) {
    .with-sidebar {
      display: grid;
      grid-template-columns: minmax(0, var(--width-main)) var(--width-side);
      justify-content: space-between;
      gap: var(--gap-columns);
      align-items: start;
    }

    .sidebar {
      position: sticky;
      top: var(--space-l);
      margin-block-start: var(--sidebar-offset, 0);
    }

    /*
     * A sidebar taller than the screen can't show its bottom (the share
     * buttons) if it sticks by its top. When it is taller, `top` goes negative,
     * so it sticks by its bottom instead. The script below sets --sidebar-height.
     * Without it (or without dvh), the plain top offset above applies.
     */
    @supports (height: 100dvh) {
      .sidebar {
        top: min(var(--space-l), calc(100dvh - var(--sidebar-height, 0px) - var(--space-l)));
      }
    }
  }
</style>

<script>
  // Tell the CSS how tall the sidebar is, and keep it up to date (fonts loading,
  // the window resizing). The sidebar is replaced on every page change, so this
  // watches whichever one is on screen.
  let watcher: ResizeObserver | undefined;

  document.addEventListener('astro:page-load', () => {
    watcher?.disconnect();
    const sidebar = document.querySelector<HTMLElement>('.sidebar');
    if (!sidebar) return;
    watcher = new ResizeObserver(() => sidebar.style.setProperty('--sidebar-height', `${sidebar.offsetHeight}px`));
    watcher.observe(sidebar);
  });
</script>
