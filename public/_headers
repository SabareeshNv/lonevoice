# Cache rules for Cloudflare Pages.

# Built files (fonts, CSS, scripts, resized images). Astro puts a fingerprint
# in every file name, so a changed file always gets a new name. Safe to keep
# for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name images and icons. The name stays the same when the file changes,
# so keep them for a day, then check again.
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-default.jpg
  Cache-Control: public, max-age=86400

# Search files. Entry files keep fixed names, so always check for updates.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate
